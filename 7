import { AsyncPipe, NgOptimizedImage } from '@angular/common';
import { Component, effect, inject } from '@angular/core';
import { Observable } from 'rxjs';
import { PokemonService, PokemonDetails } from '../pokemon/pokemon-service/pokemon-service';
import { RouterLink } from '@angular/router';
import { ActivatedRoute } from '@angular/router';

@Component({
  imports: [AsyncPipe, NgOptimizedImage, RouterLink],
  selector: 'app-home',
  styleUrl: './home.scss',
  templateUrl: './home.html',
})
export class Home {
  readonly pageId: string;

  pokemonsPaginated$!: Observable<PokemonDetails[]>;

  private pokemonService = inject(PokemonService);
  private route = inject(ActivatedRoute)

  constructor() {
    this.pageId = this.route.snapshot.paramMap.get('page') || '';

    effect(() => {
      this.pokemonsPaginated$ = this.pokemonService.getPokemonsByPage(Number.parseInt(this.pageId));
    })
  }

  changePage(direction: "prev" | "next") {
  }
}
